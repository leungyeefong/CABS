# ============================================================
# Step 20A. Build the deterministic agent interpretation layer
# Purpose:
# Convert the model prediction and SHAP explanation into a
# structured, human-readable clinical trial risk summary.
#
# This layer does NOT call an LLM.
# It ensures that all statements are grounded in the
# XGBoost prediction and SHAP results.
# ============================================================


def build_agent_interpretation(agent_payload):

    # --------------------------------------------------------
    # Extract prediction information
    # --------------------------------------------------------

    probability = (
        agent_payload["prediction"]
        ["termination_probability"]
    )

    threshold = (
        agent_payload["prediction"]
        ["classification_threshold"]
    )

    predicted_class = (
        agent_payload["prediction"]
        ["predicted_class"]
    )


    # --------------------------------------------------------
    # Separate SHAP drivers by direction
    # --------------------------------------------------------

    increasing_drivers = []
    decreasing_drivers = []

    for driver in agent_payload["prediction_drivers"]:

        driver_summary = {
            "factor": driver["factor"],
            "shap_value": driver["shap_value"]
        }

        if driver["shap_value"] > 0:
            increasing_drivers.append(driver_summary)

        elif driver["shap_value"] < 0:
            decreasing_drivers.append(driver_summary)


    # --------------------------------------------------------
    # Determine classification statement
    # --------------------------------------------------------

    if predicted_class == 1:
        classification = (
            "Predicted termination risk exceeds "
            "the selected classification threshold."
        )
    else:
        classification = (
            "Predicted termination risk does not exceed "
            "the selected classification threshold."
        )


    # --------------------------------------------------------
    # Build structured interpretation
    # --------------------------------------------------------

    interpretation = {

        "predicted_termination_probability":
            f"{probability:.1%}",

        "classification_threshold":
            f"{threshold:.0%}",

        "classification":
            classification,

        "factors_increasing_prediction":
            increasing_drivers,

        "factors_decreasing_prediction":
            decreasing_drivers,

        "interpretation_note": (
            "SHAP values describe how each feature contributes "
            "to this model prediction. They represent model "
            "associations and should not be interpreted as "
            "causal effects."
        )
    }

    return interpretation


# ============================================================
# Apply the interpretation function
# ============================================================

agent_interpretation = build_agent_interpretation(
    agent_payload
)


