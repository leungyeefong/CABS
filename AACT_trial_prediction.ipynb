    "enrollment": None,
    "start_year": None,
    "phase": None,
    "sponsor": None,
    "intervention": None,
    "disease": None
}


# ------------------------------------------------------------
# Function for one conversational turn
# ------------------------------------------------------------

def clinical_trial_conversation(user_text, state):

    # 1. Update stored trial information
    updated_state = update_trial_state(
        state,
        user_text
    )

    # 2. Check for missing fields
    required_fields = [
        "enrollment",
        "start_year",
        "phase",
        "sponsor",
        "intervention",
        "disease"
    ]

    missing_fields = [
        field
        for field in required_fields
        if updated_state.get(field) is None
    ]

    # 3. Ask follow-up if information is incomplete
    if missing_fields:

        followup_question = generate_followup_question(
            missing_fields
        )

        return {
            "status": "Missing information",
            "state": updated_state,
            "missing_fields": missing_fields,
            "followup_question": followup_question,
            "result": None
        }

    # 4. Run validated prediction when complete
    result = validated_clinical_trial_agent(
        enrollment=updated_state["enrollment"],
        start_year=updated_state["start_year"],
        phase=updated_state["phase"],
        sponsor=updated_state["sponsor"],
        intervention=updated_state["intervention"],
        disease=updated_state["disease"]
    )

    return {
        "status": result["status"],
        "state": updated_state,
        "missing_fields": [],
        "followup_question": None,
        "result": result
    }



