# ============================================================
# Step 18D. SHAP sensitivity analysis in the restricted cohort
# Purpose:
# Determine whether the major predictors of trial termination
# remain important after excluding trials started after 2022.
#
# In particular, this analysis tests whether enrollment remains
# the dominant predictor after excluding the newest trial cohorts.
# ============================================================

import shap
import numpy as np
import pandas as pd

# ------------------------------------------------------------
# 1. Sample 5,000 trials from the restricted test set
# ------------------------------------------------------------

X_test_restricted_sample = X_test_restricted.sample(
    n=min(5000, len(X_test_restricted)),
    random_state=42
)

# ------------------------------------------------------------
# 2. Transform predictors using the fitted restricted
#    preprocessing pipeline
# ------------------------------------------------------------

restricted_preprocessor = (
    xgboost_restricted
    .named_steps["preprocessor"]
)

X_restricted_transformed = (
    restricted_preprocessor
    .transform(X_test_restricted_sample)
)

# Convert sparse matrix to dense if necessary
if hasattr(X_restricted_transformed, "toarray"):
    X_restricted_transformed = (
        X_restricted_transformed.toarray()
    )

# Get transformed feature names
restricted_feature_names = (
    restricted_preprocessor
    .get_feature_names_out()
)

# Clean feature-name prefixes
restricted_feature_names_clean = [
    name
    .replace("cat__", "")
    .replace("num__", "")
    .replace("binary__", "")
    for name in restricted_feature_names
]

# ------------------------------------------------------------
# 3. Calculate SHAP values
# ------------------------------------------------------------

restricted_classifier = (
    xgboost_restricted
    .named_steps["classifier"]
)

restricted_explainer = shap.TreeExplainer(
    restricted_classifier
)

restricted_shap_values = restricted_explainer(
    X_restricted_transformed
)

restricted_shap_values.feature_names = (
    restricted_feature_names_clean
)

# ------------------------------------------------------------
# 4. Calculate global mean absolute SHAP importance
# ------------------------------------------------------------

restricted_mean_abs_shap = np.abs(
    restricted_shap_values.values
).mean(axis=0)

restricted_shap_importance = pd.DataFrame({
    "Predictor": restricted_feature_names_clean,
    "Mean_abs_SHAP": restricted_mean_abs_shap
})

restricted_shap_importance = (
    restricted_shap_importance
    .sort_values(
        "Mean_abs_SHAP",
        ascending=False
    )
    .reset_index(drop=True)
)

print("Top 15 predictors in restricted cohort")
print("=" * 55)

print(
    restricted_shap_importance
    .head(15)
    .to_string(
        index=False,
        float_format=lambda x: f"{x:.3f}"
    )
)



