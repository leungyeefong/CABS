# ============================================================
# Step 21D. Generate follow-up questions for missing inputs
# Purpose:
# Allow the agent to respond conversationally when required
# trial characteristics are missing.
#
# Instead of simply reporting missing variables, the agent
# tells the user what information is needed before prediction.
# ============================================================


def generate_followup_question(missing_fields):

    # Human-readable names for model inputs
    field_labels = {
        "enrollment": "planned enrollment",
        "start_year": "trial start year",
        "phase": "trial phase",
        "sponsor": "sponsor type",
        "intervention": "intervention type",
        "disease": "disease area"
    }

    readable_fields = [
        field_labels[field]
        for field in missing_fields
    ]


    # --------------------------------------------------------
    # Create natural-language question
    # --------------------------------------------------------

    if len(readable_fields) == 1:

        question = (
            f"Please provide the {readable_fields[0]} "
            "before I generate the prediction."
        )

    elif len(readable_fields) == 2:

        question = (
            f"Please provide the {readable_fields[0]} and "
            f"{readable_fields[1]} before I generate the prediction."
        )

    else:

        question = (
            "Please provide the following information before "
            "I generate the prediction: "
            + ", ".join(readable_fields[:-1])
            + f", and {readable_fields[-1]}."
        )


    return question



