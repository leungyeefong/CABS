# ============================================================
# Step 14A. Prepare a SHAP sample from the test set
# Purpose:
# Randomly sample 5,000 trials from the held-out test set
# and apply the fitted preprocessing pipeline.
#
# Using a sample keeps SHAP computation fast and memory-efficient
# while still providing a representative view of model behavior.
# ============================================================

# Randomly sample 5,000 test observations
X_test_sample = X_test.sample(
    n=5000,
    random_state=42
)

# Apply the fitted preprocessing pipeline
X_test_sample_transformed = (
    xgboost_model
    .named_steps["preprocessor"]
    .transform(X_test_sample)
)

# Get the transformed feature names
shap_feature_names = (
    xgboost_model
    .named_steps["preprocessor"]
    .get_feature_names_out()
)

print("Original SHAP sample shape:", X_test_sample.shape)
print("Transformed SHAP sample shape:", X_test_sample_transformed.shape)
print("Number of transformed features:", len(shap_feature_names))



# ============================================================
# Step 14B. Calculate SHAP values for the XGBoost model
# Purpose:
# Quantify how each predictor contributes to the XGBoost
# termination prediction for the sampled test trials.
#
# Positive SHAP values push the prediction toward termination.
# Negative SHAP values push the prediction away from termination.
# ============================================================

# Extract the fitted XGBoost classifier
shap_xgb_model = xgboost_model.named_steps["classifier"]

# Create a TreeExplainer
explainer = shap.TreeExplainer(shap_xgb_model)

# Calculate SHAP values
shap_values = explainer(
    X_test_sample_transformed
)

# Add readable feature names
shap_values.feature_names = shap_feature_names.tolist()

print("SHAP values calculated successfully.")
print("SHAP matrix shape:", shap_values.values.shape)




# ============================================================
# Step 15A. Create the SHAP beeswarm summary plot
# Purpose:
# Visualize both the importance and direction of predictor
# effects on XGBoost predictions.
#
# Each point represents one trial.
# - Positive SHAP values push predictions toward termination.
# - Negative SHAP values push predictions away from termination.
# - Red indicates a higher feature value.
# - Blue indicates a lower feature value.
# ============================================================

import matplotlib.pyplot as plt

# Create readable feature names by removing preprocessing prefixes
clean_shap_feature_names = [
    name.replace("cat__", "")
        .replace("num__", "")
        .replace("binary__", "")
    for name in shap_feature_names
]

# Update feature names
shap_values.feature_names = clean_shap_feature_names

# Create beeswarm plot
shap.plots.beeswarm(
    shap_values,
    max_display=20,
    show=False
)

plt.title(
    "SHAP Summary for Clinical Trial Termination Prediction",
    fontsize=14
)

plt.tight_layout()
plt.show()



# ============================================================
# Step 15B. Create the SHAP global importance plot
# Purpose:
# Rank predictors according to their mean absolute SHAP value.
#
# This summarizes the overall contribution of each predictor
# to XGBoost predictions across the sampled test trials.
# ============================================================

shap.plots.bar(
    shap_values,
    max_display=20,
    show=False
)

plt.title(
    "Global Predictor Importance for Clinical Trial Termination",
    fontsize=14
)

plt.tight_layout()
plt.show()




# ============================================================
# Step 15C. Convert SHAP enrollment values to actual enrollment
# Purpose:
# Convert standardized log enrollment back to the approximate
# number of trial participants for easier interpretation.
#
# Also estimate the enrollment level at which the SHAP
# contribution changes from positive to negative.
# ============================================================

import numpy as np
import matplotlib.pyplot as plt

# Find the transformed position of log_enrollment
log_enrollment_idx = list(shap_feature_names).index("num__log_enrollment")

# Standardized log enrollment used by the XGBoost model
standardized_log_enrollment = np.asarray(
    X_test_sample_transformed[:, log_enrollment_idx]
).ravel()

# Get the fitted scaler from the XGBoost preprocessing pipeline
fitted_numeric_pipeline = (
    xgboost_model
    .named_steps["preprocessor"]
    .named_transformers_["num"]
)

scaler = fitted_numeric_pipeline.named_steps["scaler"]

# log_enrollment is the second numeric variable:
# ["start_year", "log_enrollment"]
log_mean = scaler.mean_[1]
log_scale = scaler.scale_[1]

# Reverse standardization
original_log_enrollment = (
    standardized_log_enrollment * log_scale + log_mean
)

# Reverse log1p transformation
actual_enrollment = np.expm1(original_log_enrollment)

# Get SHAP values for enrollment
enrollment_shap = shap_values.values[:, log_enrollment_idx]

# ------------------------------------------------------------
# Estimate SHAP = 0 crossing
# Use observations closest to zero SHAP value
# ------------------------------------------------------------

closest_idx = np.argsort(np.abs(enrollment_shap))[:100]

threshold_estimate = np.median(
    actual_enrollment[closest_idx]
)

print(
    "Approximate enrollment where SHAP approaches zero:",
    round(threshold_estimate)
)

# ------------------------------------------------------------
# Plot actual enrollment vs SHAP
# Restrict x-axis to 99th percentile so extreme very large
