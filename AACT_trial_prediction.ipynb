    agent_interpretation,
    sort_dicts=False
)



# ============================================================
# Step 20B. Build the integrated clinical trial prediction agent
# Purpose:
# Combine trial input, XGBoost prediction, local SHAP
# explanation, and human-readable interpretation into one
# reusable function.
#
# This function forms the core analytical engine of the agent.
# ============================================================


def clinical_trial_agent(
    enrollment,
    start_year,
    phase,
    sponsor,
    intervention,
    disease
):

    # --------------------------------------------------------
    # 1. Generate model prediction
    # --------------------------------------------------------

    prediction = predict_trial_termination(
    enrollment=enrollment,
    start_year=start_year,
    phase=phase,
    agency_class=sponsor,
    interventions=[intervention],
    diseases=[disease]
    )

    trial = prediction["model_input"]


    # --------------------------------------------------------
    # 2. Transform trial using fitted preprocessing pipeline
    # --------------------------------------------------------

    trial_transformed = (
        xgboost_model
        .named_steps["preprocessor"]
        .transform(trial)
    )

    if hasattr(trial_transformed, "toarray"):
        trial_transformed = trial_transformed.toarray()


    # --------------------------------------------------------
    # 3. Calculate local SHAP values
    # --------------------------------------------------------

    trial_shap = explainer(
        trial_transformed
    )

    trial_shap.feature_names = clean_feature_names


    # --------------------------------------------------------
    # 4. Build SHAP table
    # --------------------------------------------------------

    explanation = pd.DataFrame({
        "Feature": clean_feature_names,
        "Feature_value": trial_transformed[0],
        "SHAP_value": trial_shap.values[0]
    })

    explanation["Absolute_SHAP"] = (
        explanation["SHAP_value"].abs()
    )


    # --------------------------------------------------------
    # 5. Keep interpretable features
    # --------------------------------------------------------

    continuous_features = [
        "log_enrollment",
        "start_year"
    ]

    explanation = explanation[
        (
            explanation["Feature"].isin(
                continuous_features
            )
        )
        |
        (
            (~explanation["Feature"].isin(
                continuous_features
            ))
            &
            (explanation["Feature_value"] == 1)
        )
    ].copy()


    explanation = (
        explanation
        .sort_values(
            "Absolute_SHAP",
            ascending=False
        )
        .reset_index(drop=True)
    )


    # --------------------------------------------------------
    # 6. Convert model feature names to readable labels
    # --------------------------------------------------------

    readable_labels = {
        "log_enrollment": "Enrollment",
        "start_year": "Start year",
        f"phase_{phase}": phase.replace("_", " ").title(),
        f"agency_class_{sponsor}": (
            sponsor.replace("_", " ").title()
            + " sponsor"
        ),
        intervention: (
            intervention.replace("_", " ").title()
            + " intervention"
        ),
        f"DISEASE_{disease}": disease
    }


    # --------------------------------------------------------
    # 7. Build prediction drivers
    # --------------------------------------------------------

    prediction_drivers = []

    for _, row in explanation.iterrows():

        factor = readable_labels.get(
            row["Feature"],
            row["Feature"]
        )

        shap_value = float(row["SHAP_value"])

        prediction_drivers.append({
            "factor": factor,
            "shap_value": round(shap_value, 3),
            "direction": (
                "Increases predicted termination"
                if shap_value > 0
                else "Decreases predicted termination"
            )
        })


    # --------------------------------------------------------
    # 8. Build agent payload
    # --------------------------------------------------------

    payload = {

        "trial_characteristics": {
            "Enrollment": enrollment,
            "Start year": start_year,
            "Phase": phase,
            "Sponsor": sponsor,
            "Intervention": intervention,
            "Disease": disease
        },

        "prediction": {
            "termination_probability": float(
                prediction["termination_probability"]
            ),
            "classification_threshold": float(
                prediction["classification_threshold"]
            ),
            "predicted_class": int(
                prediction["predicted_class"]
            )
        },

        "prediction_drivers":
            prediction_drivers
    }


    # --------------------------------------------------------
    # 9. Generate deterministic interpretation
    # --------------------------------------------------------

    interpretation = build_agent_interpretation(
        payload
    )


    # --------------------------------------------------------
    # 10. Return complete agent result
    # --------------------------------------------------------

    return {
        "trial_characteristics":
            payload["trial_characteristics"],

        "prediction":
            payload["prediction"],

        "prediction_drivers":
            payload["prediction_drivers"],

        "interpretation":
            interpretation
    }



