}


# ------------------------------------------------------------
# Helper function
# ------------------------------------------------------------

def run_stress_test(variable_name, values):

    results = []

    for value in values:

        trial = reference_trial.copy()
        trial[variable_name] = value

        output = validated_clinical_trial_agent(
            enrollment=trial["enrollment"],
            start_year=trial["start_year"],
            phase=trial["phase"],
            sponsor=trial["sponsor"],
            intervention=trial["intervention"],
            disease=trial["disease"]
        )

        if output["status"] == "Prediction completed":

            prediction = output["result"]["prediction"]

            results.append({
                variable_name: value,
                "Termination_probability":
                    prediction["termination_probability"],
                "Predicted_class":
                    prediction["predicted_class"]
            })

        else:

            results.append({
                variable_name: value,
                "Termination_probability": None,
                "Predicted_class": None
            })

    return pd.DataFrame(results)



