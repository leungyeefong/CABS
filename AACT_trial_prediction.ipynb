# ============================================================
# Step 19E. Build an agent-ready prediction function
# Purpose:
# Convert simple trial characteristics into the 45 original
# model predictors and return the XGBoost-predicted probability
# of trial termination.
#
# This function will later serve as the prediction engine
# called by the AI agent.
# ============================================================

def predict_trial_termination(
    enrollment,
    start_year,
    phase,
    agency_class,
    interventions=None,
    diseases=None
):

    # --------------------------------------------------------
    # Handle optional multiple selections
    # --------------------------------------------------------

    if interventions is None:
        interventions = []

    if diseases is None:
        diseases = []


    # --------------------------------------------------------
    # Start with one row containing every original predictor
    # --------------------------------------------------------

    trial = pd.DataFrame(
        [{
            col: 0 for col in X.columns
        }]
    )


    # --------------------------------------------------------
    # Continuous / categorical trial characteristics
    # --------------------------------------------------------

    trial["log_enrollment"] = np.log1p(enrollment)

    trial["start_year"] = start_year

    trial["phase"] = phase

    trial["agency_class"] = agency_class


    # --------------------------------------------------------
    # Intervention indicators
    # --------------------------------------------------------

    intervention_columns = [
        "BEHAVIORAL",
        "BIOLOGICAL",
        "COMBINATION_PRODUCT",
        "DEVICE",
        "DIAGNOSTIC_TEST",
        "DIETARY_SUPPLEMENT",
        "DRUG",
        "GENETIC",
        "OTHER",
        "PROCEDURE",
        "RADIATION"
    ]

    for intervention in interventions:

        if intervention not in intervention_columns:
            raise ValueError(
                f"Unknown intervention type: {intervention}"
            )

        trial[intervention] = 1


    # --------------------------------------------------------
    # Disease indicators
    # --------------------------------------------------------

    disease_columns = [
        col for col in X.columns
        if col.startswith("DISEASE_")
    ]

    for disease in diseases:

        disease_col = (
            disease
            if disease.startswith("DISEASE_")
            else f"DISEASE_{disease}"
        )

        if disease_col not in disease_columns:
            raise ValueError(
                f"Unknown disease category: {disease}"
            )

        trial[disease_col] = 1


    # --------------------------------------------------------
    # Preserve exact training-column order
    # --------------------------------------------------------

    trial = trial[X.columns]


    # --------------------------------------------------------
    # Generate predicted probability
    # --------------------------------------------------------

    termination_probability = (
        xgboost_model
        .predict_proba(trial)[0, 1]
    )


    # --------------------------------------------------------
    # Apply the threshold selected previously
    # --------------------------------------------------------

    classification_threshold = 0.25

    predicted_class = int(
        termination_probability >= classification_threshold
    )


    return {
        "termination_probability": termination_probability,
        "classification_threshold": classification_threshold,
        "predicted_class": predicted_class,
        "model_input": trial
    }



