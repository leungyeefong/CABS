# ============================================================
# Step 21E. Build the conversational agent workflow
# Purpose:
# Combine natural-language parsing, completeness checking,
# follow-up generation, validation, and model prediction
# into a single user-facing workflow.
#
# Workflow:
# User description
#       ↓
# Parse trial characteristics
#       ↓
# Check required information
#       ↓
# Missing? → Ask follow-up question
# Complete? → Validate → Predict → Explain
# ============================================================


def conversational_trial_agent(user_text):

    # --------------------------------------------------------
    # 1. Parse natural-language description
    # --------------------------------------------------------

    parsed_trial = parse_trial_description(user_text)


    # --------------------------------------------------------
    # 2. Identify missing required fields
    # --------------------------------------------------------

    required_fields = [
        "enrollment",
        "start_year",
        "phase",
        "sponsor",
        "intervention",
        "disease"
    ]

    missing_fields = [
        field
        for field in required_fields
        if parsed_trial.get(field) is None
    ]


    # --------------------------------------------------------
    # 3. If information is missing, ask the user
    # --------------------------------------------------------

    if missing_fields:

        followup_question = generate_followup_question(
            missing_fields
        )

        return {
            "status": "Missing information",
            "parsed_trial": parsed_trial,
            "missing_fields": missing_fields,
            "followup_question": followup_question,
            "result": None
        }


    # --------------------------------------------------------
    # 4. If complete, send trial to validated prediction agent
    # --------------------------------------------------------

    result = safe_clinical_trial_agent(
        enrollment=parsed_trial["enrollment"],
        start_year=parsed_trial["start_year"],
        phase=parsed_trial["phase"],
        sponsor=parsed_trial["sponsor"],
        intervention=parsed_trial["intervention"],
        disease=parsed_trial["disease"]
    )


    # --------------------------------------------------------
    # 5. Return complete agent response
    # --------------------------------------------------------

    return {
        "status": result["status"],
        "parsed_trial": parsed_trial,
        "missing_fields": [],
        "followup_question": None,
        "result": result
    }



