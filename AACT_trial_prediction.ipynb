                max_iter=1000,
                random_state=42
            )
        )
    ]
)


# ------------------------------------------------------------
# 3. Rebuild Random Forest
# ------------------------------------------------------------

random_forest_model = Pipeline(
    steps=[
        (
            "preprocessor",
            clone(base_preprocessor)
        ),
        (
            "classifier",
            RandomForestClassifier(
                n_estimators=200,
                max_depth=20,
                min_samples_leaf=5,
                random_state=42,
                n_jobs=-1
            )
        )
    ]
)


# ------------------------------------------------------------
