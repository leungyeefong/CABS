# Step 18E. Examine enrollment SHAP relationship in the
# restricted cohort
# Purpose:
# Determine whether the nonlinear relationship between trial
# enrollment and predicted termination remains after excluding
# trials started after 2022.
#
# This sensitivity analysis evaluates whether the previously
# observed enrollment pattern is robust to potential
# follow-up bias among recently initiated trials.
# ============================================================

import matplotlib.pyplot as plt
import numpy as np

# Find the transformed feature position for log enrollment
log_enrollment_idx = (
    restricted_feature_names_clean.index("log_enrollment")
)

# Extract standardized log enrollment values
restricted_log_enrollment_scaled = (
    X_restricted_transformed[:, log_enrollment_idx]
)

# Extract SHAP values for enrollment
restricted_enrollment_shap = (
    restricted_shap_values.values[:, log_enrollment_idx]
)

# ------------------------------------------------------------
# Recover actual enrollment
# ------------------------------------------------------------

numeric_pipeline_restricted = (
    restricted_preprocessor
    .named_transformers_["num"]
)

scaler_restricted = (
    numeric_pipeline_restricted
    .named_steps["scaler"]
)

# log_enrollment is the second numeric variable:
# ["start_year", "log_enrollment"]
log_mean = scaler_restricted.mean_[1]
log_scale = scaler_restricted.scale_[1]

# Reverse standardization
restricted_log_enrollment_original = (
    restricted_log_enrollment_scaled * log_scale
    + log_mean
)

# Reverse log1p transformation
restricted_actual_enrollment = np.expm1(
    restricted_log_enrollment_original
)

# ------------------------------------------------------------
# Find observation whose enrollment SHAP value is closest to 0
# ------------------------------------------------------------

closest_zero_idx = np.argmin(
    np.abs(restricted_enrollment_shap)
)

restricted_zero_enrollment = (
    restricted_actual_enrollment[closest_zero_idx]
