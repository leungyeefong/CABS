# ============================================================
# Step 2. Load the AACT prediction dataset
# Purpose:
# Import the trial-level dataset prepared in R and check
# the number of rows, columns, and the first few observations.
# ============================================================

import pandas as pd

df = pd.read_csv("AACT_prediction_data.csv")

print("Dataset shape:", df.shape)

df.head()



# ============================================================
# Step 3. Inspect and validate the dataset
# Purpose:
# Check variable types, missing values, duplicated trial IDs,
# and the distribution of the termination outcome before
# preparing the data for machine-learning models.
# ============================================================

# Check data types
print("Data types:")
print(df.dtypes)

# Check duplicated trial IDs
print("\nDuplicated NCT IDs:")
print(df["nct_id"].duplicated().sum())

# Check missing values
print("\nMissing values:")
print(df.isnull().sum()[df.isnull().sum() > 0])

# Check termination counts
print("\nTermination counts:")
print(df["terminated"].value_counts())

# Check termination percentages
print("\nTermination percentages:")
print(
    df["terminated"]
    .value_counts(normalize=True)
    .sort_index()
    .mul(100)
    .round(2)
)



# ============================================================
# Step 4. Prepare the outcome and predictor variables
# Purpose:
# Define the target variable (terminated) and the predictors
# that will be used to train the termination prediction models.
#
# - Remove nct_id because it is only a trial identifier.
# - Remove study_type because all included trials are
#   INTERVENTIONAL, so it provides no predictive information.
# - Transform enrollment using log1p because enrollment is
#   highly right-skewed with several very large values.
# ============================================================

import numpy as np

# Create a copy so the original dataset remains unchanged
model_df = df.copy()

# Log-transform enrollment
model_df["log_enrollment"] = np.log1p(model_df["enrollment"])

# Define the outcome variable
y = model_df["terminated"]

# Define predictor variables
X = model_df.drop(
    columns=[
        "nct_id",
        "terminated",
        "study_type",
        "enrollment"
    ]
)

# Check the resulting modeling dataset
print("X shape:", X.shape)
print("y shape:", y.shape)

print("\nPredictor columns:")
print(X.columns.tolist())

print("\nOutcome distribution:")
print(y.value_counts())



# ============================================================
# Step 5. Split the data into training and test sets
# Purpose:
# Divide the dataset into 80% training data and 20% test data.
#
# Stratified splitting is used because terminated trials account
# for only about 10.4% of the dataset. This keeps the termination
# proportion similar in both the training and test sets.
#
# random_state = 42 makes the split reproducible.
# ============================================================

from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# Check dataset sizes
print("Training set:", X_train.shape)
print("Test set:", X_test.shape)

# Check termination proportions
print("\nTraining termination rate:")
print(y_train.mean())

print("\nTest termination rate:")
print(y_test.mean())



# ============================================================
# Step 6. Build the preprocessing pipeline
# Purpose:
# Prepare the predictors for machine-learning models.
#
# - phase and agency_class are categorical variables:
#   missing values are filled with the most frequent category,
#   then converted to one-hot encoded variables.
#
# - start_year and log_enrollment are numeric variables:
#   missing values are filled using the median from the
#   TRAINING data only.
#
# - Intervention and disease indicators are already coded
#   as 0/1, so they are passed through without modification.
#
# The preprocessing steps will later be combined with each
# machine-learning model in a pipeline.
# ============================================================

from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer

# Define categorical variables
categorical_features = [
    "phase",
    "agency_class"
]

# Define numeric variables that contain missing values
numeric_features = [
    "start_year",
    "log_enrollment"
]

# All remaining variables are already 0/1 indicators
binary_features = [
    col for col in X.columns
    if col not in categorical_features + numeric_features
]

# Preprocessing for categorical variables
categorical_transformer = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="most_frequent")),
        (
            "onehot",
            OneHotEncoder(
                handle_unknown="ignore"
            )
        )
    ]
)

# Preprocessing for numeric variables
numeric_transformer = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="median"))
    ]
)

# Combine all preprocessing steps
preprocessor = ColumnTransformer(
    transformers=[
        ("cat", categorical_transformer, categorical_features),
        ("num", numeric_transformer, numeric_features),
        ("binary", "passthrough", binary_features)
    ]
)

# Display the feature groups
print("Categorical features:", categorical_features)
print("Numeric features:", numeric_features)
print("Number of binary features:", len(binary_features))



# ============================================================
# Step 6A. Update numeric preprocessing with standardization
# Purpose:
# Standardize continuous numeric predictors after imputing
# missing values.
#
# Scaling helps Logistic Regression converge because start_year
# and log_enrollment are measured on very different scales.
#
# The scaler is fitted using the training data only through
# the machine-learning pipeline, preventing data leakage.
# ============================================================

from sklearn.preprocessing import StandardScaler

numeric_transformer = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]
)

# Rebuild the preprocessing pipeline
preprocessor = ColumnTransformer(
    transformers=[
        ("cat", categorical_transformer, categorical_features),
        ("num", numeric_transformer, numeric_features),
        ("binary", "passthrough", binary_features)
    ]
)

print("Updated preprocessing pipeline with numeric standardization.")



# ============================================================
# Step 6B. Create a base preprocessor for independent models
# Purpose:
# Create a clean preprocessing template that can be cloned
# separately for each machine-learning model.
#
# This prevents Logistic Regression, Random Forest, and XGBoost
# from sharing and modifying the same fitted preprocessor.
# ============================================================

from sklearn.base import clone

base_preprocessor = clone(preprocessor)

print("Base preprocessor created successfully.")



# ============================================================
# Step 7. Train the baseline Logistic Regression model
# Purpose:
# Train the first clinical-trial termination prediction model
# using Logistic Regression.
#
# The preprocessing pipeline created in Step 6 is applied
# automatically before model training.
#
# This is an unweighted baseline model. Its performance will
# later be compared with Random Forest and XGBoost.
# ============================================================

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    roc_auc_score,
    average_precision_score,
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# Build the Logistic Regression pipeline
logistic_model = Pipeline(
    steps=[
        ("preprocessor", clone(base_preprocessor)),
        (
            "classifier",
            LogisticRegression(
                max_iter=1000,
                random_state=42
            )
        )
    ]
)

# Train the model using the training data
logistic_model.fit(X_train, y_train)

# Predict classes on the test set
y_pred_logistic = logistic_model.predict(X_test)

# Predict termination probabilities
y_prob_logistic = logistic_model.predict_proba(X_test)[:, 1]

print("Logistic Regression training completed.")



# ============================================================
# Step 8. Evaluate the Logistic Regression model
# Purpose:
# Evaluate how well the baseline Logistic Regression model
# predicts clinical-trial termination on the held-out test set.
#
# Because only about 10.4% of trials are terminated, accuracy
# alone can be misleading. Therefore, we evaluate:
#
# - ROC-AUC: ability to distinguish terminated vs. non-terminated
# - Average Precision (AP): summarizes precision-recall performance
#   for the minority class
# - Accuracy: overall proportion classified correctly
# - Precision: among predicted terminations, how many terminated
# - Recall: among actual terminations, how many were detected
# - F1 score: balance between precision and recall
# - Confusion matrix: detailed classification counts
# ============================================================

from sklearn.metrics import (
    roc_auc_score,
    average_precision_score,
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# Calculate performance metrics
roc_auc_logistic = roc_auc_score(
    y_test,
    y_prob_logistic
)

ap_logistic = average_precision_score(
    y_test,
    y_prob_logistic
)

accuracy_logistic = accuracy_score(
    y_test,
    y_pred_logistic
)

precision_logistic = precision_score(
    y_test,
    y_pred_logistic,
    zero_division=0
)

recall_logistic = recall_score(
    y_test,
    y_pred_logistic,
    zero_division=0
)

f1_logistic = f1_score(
    y_test,
    y_pred_logistic,
    zero_division=0
)

# Display model performance
print("Logistic Regression Performance")
print("--------------------------------")
print(f"ROC-AUC:   {roc_auc_logistic:.4f}")
print(f"Average Precision (AP): {ap_logistic:.4f}")
print(f"Accuracy:  {accuracy_logistic:.4f}")
print(f"Precision: {precision_logistic:.4f}")
print(f"Recall:    {recall_logistic:.4f}")
print(f"F1 Score:  {f1_logistic:.4f}")

# Display confusion matrix
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred_logistic))

# Display full classification report
print("\nClassification Report:")
print(
    classification_report(
        y_test,
        y_pred_logistic,
        digits=4,
        zero_division=0
    )
)



# ============================================================
# Step 9. Train the baseline Random Forest model
# Purpose:
# Train a Random Forest classifier to predict clinical-trial
# termination using the same training and test sets used for
# Logistic Regression.
#
# Random Forest can capture nonlinear relationships and
# interactions between predictors that Logistic Regression
# may not capture.
#
# The same preprocessing approach is used for fair model
# comparison, with an independent cloned preprocessor for
# each model.
# ============================================================

from sklearn.ensemble import RandomForestClassifier

# Build the Random Forest pipeline
random_forest_model = Pipeline(
    steps=[
        ("preprocessor", clone(base_preprocessor)),
        (
            "classifier",
            RandomForestClassifier(
                n_estimators=200,
                max_depth=20,
                min_samples_leaf=5,
                random_state=42,
                n_jobs=-1
            )
        )
    ]
)

# Train the model using the training data
random_forest_model.fit(X_train, y_train)

# Predict classes on the test set
y_pred_rf = random_forest_model.predict(X_test)

# Predict termination probabilities
y_prob_rf = random_forest_model.predict_proba(X_test)[:, 1]

print("Random Forest training completed.")



# ============================================================
# Step 10. Evaluate the Random Forest model
# Purpose:
# Evaluate the Random Forest model on the held-out test set
# using the same metrics used for Logistic Regression.
#
# This allows a direct comparison between the two models.
#
# Metrics:
# - ROC-AUC
# - Average Precision (AP)
# - Accuracy
# - Precision
# - Recall
# - F1 score
# - Confusion matrix
# ============================================================

# Calculate Random Forest performance metrics
roc_auc_rf = roc_auc_score(
    y_test,
    y_prob_rf
)

ap_rf = average_precision_score(
    y_test,
    y_prob_rf
)

accuracy_rf = accuracy_score(
    y_test,
    y_pred_rf
)

precision_rf = precision_score(
    y_test,
    y_pred_rf,
    zero_division=0
)

recall_rf = recall_score(
    y_test,
    y_pred_rf,
    zero_division=0
)

f1_rf = f1_score(
    y_test,
    y_pred_rf,
    zero_division=0
)

# Display Random Forest performance
print("Random Forest Performance")
print("-------------------------")
print(f"ROC-AUC:   {roc_auc_rf:.4f}")
print(f"Average Precision (AP): {ap_rf:.4f}")
print(f"Accuracy:  {accuracy_rf:.4f}")
print(f"Precision: {precision_rf:.4f}")
print(f"Recall:    {recall_rf:.4f}")
print(f"F1 Score:  {f1_rf:.4f}")

# Display confusion matrix
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred_rf))

# Display full classification report
print("\nClassification Report:")
print(
    classification_report(
        y_test,
        y_pred_rf,
        digits=4,
        zero_division=0
    )
)




# ============================================================
# Step 11. Train the baseline XGBoost model
# Purpose:
# Train the third clinical-trial termination prediction model
# using XGBoost.
#
# XGBoost uses sequentially boosted decision trees and can
# capture nonlinear relationships and interactions between
# trial characteristics.
#
# The same training/test split and preprocessing pipeline are
# used so its performance can be compared fairly with Logistic
# Regression and Random Forest.
# ============================================================

from xgboost import XGBClassifier

# Build the XGBoost pipeline
xgboost_model = Pipeline(
    steps=[
        ("preprocessor", clone(base_preprocessor)),
        (
            "classifier",
            XGBClassifier(
                n_estimators=300,
                max_depth=6,
                learning_rate=0.05,
                subsample=0.8,
                colsample_bytree=0.8,
                objective="binary:logistic",
                eval_metric="logloss",
                random_state=42,
                n_jobs=-1
            )
        )
    ]
)

# Train the model using the training data
xgboost_model.fit(X_train, y_train)

# Predict classes on the test set
y_pred_xgb = xgboost_model.predict(X_test)

# Predict termination probabilities
y_prob_xgb = xgboost_model.predict_proba(X_test)[:, 1]

print("XGBoost training completed.")



# ============================================================
# Step 12. Evaluate the XGBoost model
# Purpose:
# Evaluate XGBoost on the held-out test set using the same
# metrics used for Logistic Regression and Random Forest.
#
# Because trial termination is relatively uncommon (~10.4%),
# ROC-AUC and Average Precision (AP) are especially important 
# for comparing model discrimination.
# ============================================================

# Calculate evaluation metrics
roc_auc_xgb = roc_auc_score(y_test, y_prob_xgb)
ap_xgb = average_precision_score(y_test, y_prob_xgb)
accuracy_xgb = accuracy_score(y_test, y_pred_xgb)
precision_xgb = precision_score(y_test, y_pred_xgb)
recall_xgb = recall_score(y_test, y_pred_xgb)
f1_xgb = f1_score(y_test, y_pred_xgb)

# Display results
print("XGBoost Performance")
print("-------------------")
print(f"ROC-AUC:   {roc_auc_xgb:.4f}")
print(f"Average Precision (AP): {ap_xbg:.4f}")
print(f"Accuracy:  {accuracy_xgb:.4f}")
print(f"Precision: {precision_xgb:.4f}")
print(f"Recall:    {recall_xgb:.4f}")
print(f"F1 Score:  {f1_xgb:.4f}")

# Confusion matrix
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred_xgb))

# Classification report
print("\nClassification Report:")
print(
    classification_report(
        y_test,
        y_pred_xgb,
        digits=4,
        zero_division=0
    )
)




