# ============================================================
# Step 16A. Summarize SHAP effects for key trial predictors
# Purpose:
# Quantify the direction and magnitude of the XGBoost SHAP
# contribution when selected binary/categorical predictors
# are present.
#
# Positive mean SHAP:
#   pushes the model prediction toward trial termination.
#
# Negative mean SHAP:
#   pushes the model prediction away from trial termination.
#
# This complements global SHAP importance, which measures
# magnitude but does not directly summarize direction.
# ============================================================

import pandas as pd
import numpy as np

# Key predictors to examine
key_predictors = [
    "DRUG",
    "DEVICE",
    "BEHAVIORAL",
    "PROCEDURE",
    "BIOLOGICAL",
    "DIETARY_SUPPLEMENT",
    "agency_class_INDUSTRY",
    "phase_PHASE1",
    "phase_PHASE2",
    "phase_PHASE3"
]

results = []

for predictor in key_predictors:

    # Find transformed feature
    matches = [
        i for i, name in enumerate(shap_feature_names)
        if name.endswith(predictor)
    ]

    if len(matches) == 0:
        print(f"Feature not found: {predictor}")
        continue

    idx = matches[0]

    # Get transformed feature values
    feature_values = np.asarray(
        X_test_sample_transformed[:, idx]
    ).ravel()

    # Get corresponding SHAP values
    feature_shap = shap_values.values[:, idx]

    # For binary / one-hot variables:
    # feature == 1 means that characteristic is present
    present_mask = feature_values == 1

    mean_shap_present = np.mean(
        feature_shap[present_mask]
    )

    median_shap_present = np.median(
        feature_shap[present_mask]
    )

    n_present = np.sum(present_mask)

    results.append({
        "Predictor": predictor,
        "N_present": n_present,
        "Mean_SHAP_when_present": mean_shap_present,
        "Median_SHAP_when_present": median_shap_present
    })


shap_direction_table = pd.DataFrame(results)

# Sort by absolute mean SHAP contribution
shap_direction_table["Abs_Mean_SHAP"] = (
    shap_direction_table["Mean_SHAP_when_present"].abs()
)

shap_direction_table = (
    shap_direction_table
    .sort_values(
        "Abs_Mean_SHAP",
        ascending=False
    )
    .drop(columns="Abs_Mean_SHAP")
    .reset_index(drop=True)
)

print(
    shap_direction_table.to_string(
        index=False,
        float_format=lambda x: f"{x:.3f}"
    )
)



