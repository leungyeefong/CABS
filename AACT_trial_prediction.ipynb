# ============================================================
# Step 21F. Add multi-turn state to the clinical trial agent
# Purpose:
# Allow the agent to retain trial characteristics from an
# earlier user message and update them using follow-up answers.
#
# Example:
#
# Turn 1:
# "A Phase 2 drug trial for Cancer starting in 2022."
#
# Agent:
# "Please provide the planned enrollment and sponsor type."
#
# Turn 2:
# "100 participants and industry sponsored."
#
# Agent combines both turns and generates the prediction.
# ============================================================


def update_trial_state(current_state, new_information):

    # Parse the new user message
    new_parsed = parse_trial_description(new_information)

    # Start from previous state
    updated_state = current_state.copy()

    # Only replace fields when the new message
    # actually provides a value
    for field, value in new_parsed.items():

        if value is not None:
            updated_state[field] = value

    return updated_state


