year_check["start_year"] = (
    year_check["start_year"]
    .astype(int)
)

# Calculate sample size and termination rate for each year
termination_by_year = (
    year_check
    .groupby("start_year")
    .agg(
        N_trials=("terminated", "size"),
        N_terminated=("terminated", "sum"),
        Termination_rate=("terminated", "mean")
    )
    .reset_index()
)

# Focus on recent years
recent_years = termination_by_year[
    termination_by_year["start_year"] >= 2015
]

print(
    recent_years.to_string(
