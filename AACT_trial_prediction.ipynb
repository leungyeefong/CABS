#
# Reference trial:
# Enrollment = 100
# Start year = 2022
# Phase = PHASE2
# Sponsor = INDUSTRY
# Intervention = DRUG
# Disease = Cancer
# ============================================================


# ------------------------------------------------------------
# 1. Generate prediction and local explanation
# ------------------------------------------------------------

reference_result = validated_clinical_trial_agent(
    enrollment=100,
    start_year=2022,
    phase="PHASE2",
    sponsor="INDUSTRY",
    intervention="DRUG",
    disease="Cancer"
)

prediction = (
    reference_result["result"]["prediction"]
)

termination_probability = prediction[
    "termination_probability"
]

predicted_class = prediction[
    "predicted_class"
]


# ------------------------------------------------------------
# 2. Extract local SHAP drivers
# ------------------------------------------------------------

local_drivers = (
    reference_result["result"]["prediction_drivers"]
)


# ------------------------------------------------------------
# 3. Display prediction
# ------------------------------------------------------------

print("LOCAL PREDICTION EXPLANATION AUDIT")
print("=" * 70)

print("\nReference trial:")
print({
    "enrollment": 100,
    "start_year": 2022,
    "phase": "PHASE2",
    "sponsor": "INDUSTRY",
    "intervention": "DRUG",
    "disease": "Cancer"
})

print(
    "\nTermination probability:",
    f"{termination_probability:.1%}"
)

print(
    "Predicted class:",
    predicted_class
)


# ------------------------------------------------------------
# 4. Display local prediction drivers
# ------------------------------------------------------------

print("\nLocal SHAP drivers:")
print("-" * 70)

for driver in local_drivers:

    shap_value = driver["shap_value"]

    direction = (
        "Increases predicted termination"
        if shap_value > 0
        else "Decreases predicted termination"
    )

    print(
        f'{driver["factor"]}: '
        f'{shap_value:+.3f} '
        f'({direction})'
    )


# ------------------------------------------------------------
# 5. Identify strongest positive and negative drivers
# ------------------------------------------------------------

positive_drivers = [
    d for d in local_drivers
    if d["shap_value"] > 0
]

negative_drivers = [
    d for d in local_drivers
    if d["shap_value"] < 0
]

positive_drivers = sorted(
    positive_drivers,
    key=lambda x: abs(x["shap_value"]),
    reverse=True
)

negative_drivers = sorted(
    negative_drivers,
    key=lambda x: abs(x["shap_value"]),
    reverse=True
)


print("\nStrongest factors increasing predicted termination:")
print("-" * 70)

for driver in positive_drivers[:5]:

    print(
        f'{driver["factor"]}: '
        f'{driver["shap_value"]:+.3f}'
    )


print("\nStrongest factors decreasing predicted termination:")
print("-" * 70)

for driver in negative_drivers[:5]:

    print(
        f'{driver["factor"]}: '
        f'{driver["shap_value"]:+.3f}'
    )



# ============================================================
# Step 24. Prediction revision and explanation consistency
# Purpose:
# Evaluate whether changing one trial characteristic produces
# a corresponding change in both the predicted termination
# probability and the local SHAP explanation.
#
# Comparison:
# Original trial: Enrollment = 100
# Revised trial:  Enrollment = 500
#
# All other trial characteristics are held constant.
# ============================================================


# ------------------------------------------------------------
# 1. Original trial
# ------------------------------------------------------------

original_result = validated_clinical_trial_agent(
    enrollment=100,
    start_year=2022,
    phase="PHASE2",
    sponsor="INDUSTRY",
    intervention="DRUG",
    disease="Cancer"
)

original_prediction = (
    original_result["result"]["prediction"]
)

original_probability = original_prediction[
    "termination_probability"
]

original_class = original_prediction[
    "predicted_class"
]

original_drivers = (
    original_result["result"]["prediction_drivers"]
)


# ------------------------------------------------------------
# 2. Revised trial
# ------------------------------------------------------------

revised_result = validated_clinical_trial_agent(
    enrollment=500,
    start_year=2022,
    phase="PHASE2",
    sponsor="INDUSTRY",
    intervention="DRUG",
    disease="Cancer"
)

revised_prediction = (
    revised_result["result"]["prediction"]
)

revised_probability = revised_prediction[
    "termination_probability"
]

revised_class = revised_prediction[
    "predicted_class"
]

revised_drivers = (
    revised_result["result"]["prediction_drivers"]
)


# ------------------------------------------------------------
# 3. Extract enrollment SHAP contribution
# ------------------------------------------------------------

def get_driver_shap(drivers, factor_name):

    for driver in drivers:

        if driver["factor"] == factor_name:
            return driver["shap_value"]

    return None


original_enrollment_shap = get_driver_shap(
    original_drivers,
    "Enrollment"
)

revised_enrollment_shap = get_driver_shap(
    revised_drivers,
    "Enrollment"
)


# ------------------------------------------------------------
# 4. Display prediction comparison
# ------------------------------------------------------------

print("PREDICTION REVISION AND EXPLANATION CONSISTENCY")
print("=" * 70)

print("\nTrial characteristics held constant:")
print({
    "start_year": 2022,
    "phase": "PHASE2",
    "sponsor": "INDUSTRY",
    "intervention": "DRUG",
    "disease": "Cancer"
})

print("\nPrediction comparison:")
print("-" * 70)

print(
    f"Original enrollment (100): "
    f"{original_probability:.1%} "
    f"| Class {original_class}"
)

print(
    f"Revised enrollment (500):  "
    f"{revised_probability:.1%} "
    f"| Class {revised_class}"
)

probability_change = (
    revised_probability - original_probability
)

print(
    "\nAbsolute probability change:",
    f"{probability_change:+.1%}"
)


# ------------------------------------------------------------
# 5. Compare enrollment SHAP contribution
# ------------------------------------------------------------

print("\nEnrollment SHAP contribution:")
print("-" * 70)

print(
    "Enrollment = 100:",
    f"{original_enrollment_shap:+.3f}"
)

print(
    "Enrollment = 500:",
    f"{revised_enrollment_shap:+.3f}"
)

print(
    "Change in enrollment SHAP:",
    f"{revised_enrollment_shap - original_enrollment_shap:+.3f}"
)


# ------------------------------------------------------------
# 6. Display revised local explanation
# ------------------------------------------------------------

print("\nRevised trial local SHAP drivers:")
print("-" * 70)

for driver in revised_drivers:

    shap_value = driver["shap_value"]

    direction = (
        "Increases predicted termination"
        if shap_value > 0
        else "Decreases predicted termination"
    )

    print(
        f'{driver["factor"]}: '
        f'{shap_value:+.3f} '
        f'({direction})'
    )


# ------------------------------------------------------------
# 7. Consistency check
# ------------------------------------------------------------

expected_direction = (
    revised_probability < original_probability
    and revised_enrollment_shap < original_enrollment_shap
)

print("\nConsistency check:")
print("-" * 70)

print(
    "Increasing enrollment lowered predicted termination:",
    revised_probability < original_probability
)

print(
    "Enrollment SHAP became more protective:",
    revised_enrollment_shap < original_enrollment_shap
)

print(
    "Prediction and explanation direction consistent:",
    expected_direction
)



