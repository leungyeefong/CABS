# ============================================================
# Step 24B. Connect natural-language input to the validated
# clinical trial prediction agent
#
# Purpose:
# Allow a user to provide a clinical trial description in
# natural language and automatically:
#
# 1. Parse the description
# 2. Check whether all required variables were identified
# 3. Validate the extracted variables
# 4. Run the prediction model
# 5. Generate the SHAP-based interpretation
# ============================================================

def natural_language_trial_agent(text):

    # --------------------------------------------------------
    # 1. Parse natural-language description
    # --------------------------------------------------------

    parsed = parse_trial_description(text)


    # --------------------------------------------------------
    # 2. Check for missing required information
    # --------------------------------------------------------

    required_fields = [
        "enrollment",
        "start_year",
        "phase",
        "sponsor",
        "intervention",
        "disease"
    ]

    missing_fields = [
        field
        for field in required_fields
        if parsed[field] is None
    ]


    # --------------------------------------------------------
    # 3. Stop if required information is missing
    # --------------------------------------------------------

    if missing_fields:

        return {
            "status": "Missing information",
            "original_text": text,
            "parsed_trial": parsed,
            "missing_fields": missing_fields,
            "prediction": None
        }


    # --------------------------------------------------------
    # 4. Send structured inputs to validated agent
    # --------------------------------------------------------

    agent_result = validated_clinical_trial_agent(
        enrollment=parsed["enrollment"],
        start_year=parsed["start_year"],
        phase=parsed["phase"],
        sponsor=parsed["sponsor"],
        intervention=parsed["intervention"],
        disease=parsed["disease"]
    )


    # --------------------------------------------------------
    # 5. Return complete result
    # --------------------------------------------------------

    return {
        "status": agent_result["status"],
        "original_text": text,
        "parsed_trial": parsed,
        "agent_result": agent_result
    }



