        }
    )
)



# ============================================================
# Step 20E. Create the final user-facing agent report
# Purpose:
# Convert the integrated model output into a concise,
# human-readable clinical trial termination risk report.
#
# The report is generated entirely from model outputs and SHAP
# explanations. No external LLM is used at this stage.
# ============================================================


def generate_agent_report(result):

    characteristics = result["trial_characteristics"]
    prediction = result["prediction"]
    drivers = result["prediction_drivers"]

    probability = prediction["termination_probability"]
    threshold = prediction["classification_threshold"]


    # --------------------------------------------------------
    # Separate increasing and decreasing prediction drivers
    # --------------------------------------------------------

    increasing = [
        d for d in drivers
        if d["shap_value"] > 0
    ]

    decreasing = [
        d for d in drivers
        if d["shap_value"] < 0
    ]


    # --------------------------------------------------------
    # Sort each group by absolute SHAP magnitude
    # --------------------------------------------------------

    increasing = sorted(
        increasing,
        key=lambda x: abs(x["shap_value"]),
        reverse=True
    )

    decreasing = sorted(
        decreasing,
        key=lambda x: abs(x["shap_value"]),
        reverse=True
    )


    # --------------------------------------------------------
    # Print report
    # --------------------------------------------------------

    print("=" * 70)
    print("CLINICAL TRIAL TERMINATION PREDICTION REPORT")
    print("=" * 70)


    print("\nTrial Characteristics")
    print("-" * 30)

    for key, value in characteristics.items():
        print(f"{key}: {value}")


    print("\nModel Prediction")
    print("-" * 30)

    print(
        f"Predicted termination probability: "
        f"{probability:.1%}"
    )

    print(
        f"Classification threshold: "
        f"{threshold:.0%}"
    )

    if probability >= threshold:
        print(
            "Classification: Above selected "
            "termination-risk threshold"
        )
    else:
        print(
            "Classification: Below selected "
            "termination-risk threshold"
        )


    print("\nMajor Factors Increasing the Prediction")
    print("-" * 45)

    if increasing:
        for driver in increasing[:5]:
            print(
                f"- {driver['factor']} "
                f"(SHAP: +{driver['shap_value']:.3f})"
            )
    else:
        print("- None among the displayed trial characteristics")


    print("\nMajor Factors Decreasing the Prediction")
    print("-" * 45)

    if decreasing:
        for driver in decreasing[:5]:
            print(
                f"- {driver['factor']} "
                f"(SHAP: {driver['shap_value']:.3f})"
            )
    else:
        print("- None among the displayed trial characteristics")


    print("\nInterpretation")
    print("-" * 30)

    print(
        "The SHAP values describe how the trial characteristics "
        "contributed to this model prediction relative to the "
        "model baseline. Positive values push the prediction "
        "toward termination, while negative values push it away "
        "from termination."
    )

    print(
        "\nThese results describe associations learned from "
        "historical clinical trial data and should not be "
        "interpreted as causal effects or clinical recommendations."
    )


# ============================================================
# Test the final report
# ============================================================

generate_agent_report(trial_1)



# ============================================================
# Step 20F. Add input validation to the clinical trial agent
# Purpose:
# Validate user-provided trial characteristics before they are
# passed to the prediction model.
#
# This prevents invalid or unsupported values from silently
# producing predictions.
# ============================================================


def validate_trial_inputs(
    enrollment,
    start_year,
    phase,
    sponsor,
    intervention,
    disease
):

    errors = []
    warnings = []


    # --------------------------------------------------------
    # 1. Enrollment
    # --------------------------------------------------------

    if not isinstance(enrollment, (int, float)):
        errors.append(
            "Enrollment must be numeric."
        )

    elif enrollment <= 0:
        errors.append(
            "Enrollment must be greater than 0."
        )


    # --------------------------------------------------------
    # 2. Start year
    # --------------------------------------------------------

    if not isinstance(start_year, (int, float)):
        errors.append(
            "Start year must be numeric."
        )

    elif start_year < 1900 or start_year > 2026:
        errors.append(
            "Start year must be between 1900 and 2026."
        )


    # --------------------------------------------------------
    # 3. Allowed categorical values
    # --------------------------------------------------------

    valid_phases = [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE1/PHASE2",
        "PHASE2",
        "PHASE2/PHASE3",
        "PHASE3",
        "PHASE4",
        "UNKNOWN"
    ]

    valid_sponsors = [
        "INDUSTRY",
        "NIH",
        "FED",
        "OTHER_GOV",
        "NETWORK",
        "OTHER",
        "UNKNOWN"
    ]

    valid_interventions = [
        "BEHAVIORAL",
        "BIOLOGICAL",
        "COMBINATION_PRODUCT",
        "DEVICE",
        "DIAGNOSTIC_TEST",
        "DIETARY_SUPPLEMENT",
        "DRUG",
        "GENETIC",
        "OTHER",
        "PROCEDURE",
        "RADIATION"
    ]


    if phase not in valid_phases:
        errors.append(
            f"Unsupported phase: {phase}"
        )

    if sponsor not in valid_sponsors:
        errors.append(
            f"Unsupported sponsor type: {sponsor}"
        )

    if intervention not in valid_interventions:
        errors.append(
            f"Unsupported intervention type: {intervention}"
        )


    # --------------------------------------------------------
    # 4. Disease
    #
    # Disease categories are represented by binary indicators
    # in the model. Check whether the requested disease exists
    # among the model inputs.
    # --------------------------------------------------------

    disease_feature = f"DISEASE_{disease}"

    if disease_feature not in X.columns:
        errors.append(
            f"Unsupported disease category: {disease}"
        )


    # --------------------------------------------------------
    # 5. Return validation result
    # --------------------------------------------------------

    return {
        "valid": len(errors) == 0,
        "errors": errors,
        "warnings": warnings
    }



# ============================================================
# Step 20G. Integrate input validation into the clinical
# trial prediction agent
#
# Purpose:
# Create a validated agent interface that checks trial inputs
# before running the existing prediction and interpretation
# pipeline.
# ============================================================

def validated_clinical_trial_agent(
    enrollment,
    start_year,
    phase,
    sponsor,
    intervention,
    disease
):

    # --------------------------------------------------------
    # 1. Validate inputs
    # --------------------------------------------------------

    validation = validate_trial_inputs(
        enrollment=enrollment,
        start_year=start_year,
        phase=phase,
        sponsor=sponsor,
        intervention=intervention,
        disease=disease
    )


    # --------------------------------------------------------
    # 2. Stop if invalid inputs are detected
    # --------------------------------------------------------

    if not validation["valid"]:

        return {
            "status": "Input validation failed",
            "errors": validation["errors"],
            "warnings": validation["warnings"],
            "prediction": None
        }


    # --------------------------------------------------------
    # 3. Run the existing clinical trial agent
    # --------------------------------------------------------

    result = clinical_trial_agent(
        enrollment=enrollment,
        start_year=start_year,
        phase=phase,
        sponsor=sponsor,
        intervention=intervention,
        disease=disease
    )


    # --------------------------------------------------------
    # 4. Add validation status to agent output
    # --------------------------------------------------------

    return {
        "status": "Prediction completed",
        "validation": validation,
        "result": result
    }





# ============================================================
# Step 21A. Build a simple natural-language trial parser
# Purpose:
# Convert a short free-text clinical trial description into
# structured model inputs:
#
# - enrollment
# - start year
# - phase
# - sponsor
# - intervention
# - disease
#
# This is a rule-based prototype and does not use an external
# language model yet.
# ============================================================

import re


def parse_trial_description(text):

    text_upper = text.upper()

    parsed = {
        "enrollment": None,
        "start_year": None,
        "phase": None,
        "sponsor": None,
        "intervention": None,
        "disease": None
    }


    # --------------------------------------------------------
    # 1. Enrollment
    # --------------------------------------------------------

    enrollment_patterns = [
        r"(\d+)\s+PARTICIPANTS",
        r"(\d+)\s+PATIENTS",
        r"ENROLLMENT\s*(?:OF|=|:)?\s*(\d+)"
    ]

    for pattern in enrollment_patterns:
        match = re.search(pattern, text_upper)

        if match:
            parsed["enrollment"] = int(match.group(1))
            break


    # --------------------------------------------------------
    # 2. Start year
    # --------------------------------------------------------

    year_match = re.search(
        r"\b(19\d{2}|20\d{2})\b",
        text_upper
    )

    if year_match:
        parsed["start_year"] = int(
            year_match.group(1)
        )


    # --------------------------------------------------------
    # 3. Phase
    # --------------------------------------------------------

    phase_mapping = {
        "EARLY PHASE 1": "EARLY_PHASE1",
        "PHASE 1/2": "PHASE1/PHASE2",
        "PHASE 1 / PHASE 2": "PHASE1/PHASE2",
        "PHASE 2/3": "PHASE2/PHASE3",
        "PHASE 2 / PHASE 3": "PHASE2/PHASE3",
        "PHASE 1": "PHASE1",
        "PHASE 2": "PHASE2",
        "PHASE 3": "PHASE3",
        "PHASE 4": "PHASE4"
    }

    for phrase, code in phase_mapping.items():

        if phrase in text_upper:
            parsed["phase"] = code
            break


    # --------------------------------------------------------
    # 4. Sponsor
    # --------------------------------------------------------

    sponsor_mapping = {
        "INDUSTRY": "INDUSTRY",
        "NIH": "NIH",
        "FEDERAL": "FED",
        "OTHER GOVERNMENT": "OTHER_GOV"
    }

    for phrase, code in sponsor_mapping.items():

        if phrase in text_upper:
            parsed["sponsor"] = code
            break


    # --------------------------------------------------------
    # 5. Intervention
    # --------------------------------------------------------

    intervention_mapping = {
        "DRUG": "DRUG",
        "DEVICE": "DEVICE",
        "BEHAVIORAL": "BEHAVIORAL",
        "BIOLOGICAL": "BIOLOGICAL",
        "PROCEDURE": "PROCEDURE",
        "RADIATION": "RADIATION",
        "GENETIC": "GENETIC",
        "DIAGNOSTIC": "DIAGNOSTIC_TEST",
        "DIETARY SUPPLEMENT": "DIETARY_SUPPLEMENT",
        "COMBINATION PRODUCT": "COMBINATION_PRODUCT"
    }

    for phrase, code in intervention_mapping.items():

        if phrase in text_upper:
            parsed["intervention"] = code
            break


    # --------------------------------------------------------
    # 6. Disease
    # --------------------------------------------------------

    disease_columns = [
        col.replace("DISEASE_", "")
        for col in X.columns
        if col.startswith("DISEASE_")
    ]

    for disease in disease_columns:

        if disease.upper() in text_upper:
            parsed["disease"] = disease
            break


    return parsed



