# ============================================================
# Step 21H. Generate a user-facing agent response
# Purpose:
# Convert the structured model output into a concise,
# interpretable natural-language prediction report.
#
# The response will include:
#   1. Predicted termination probability
#   2. Comparison with the selected classification threshold
#   3. Major factors increasing the prediction
#   4. Major factors decreasing the prediction
#   5. Appropriate interpretation disclaimer
# ============================================================


def generate_agent_response(agent_output, top_n=3):

    # --------------------------------------------------------
    # 1. Handle incomplete or invalid inputs
    # --------------------------------------------------------

    if agent_output["status"] == "Missing information":

        return agent_output["followup_question"]


    if agent_output["result"] is None:

        return (
            "A prediction could not be generated because "
            "the trial information was incomplete or invalid."
        )


    # --------------------------------------------------------
    # 2. Extract model result
    # --------------------------------------------------------

    result = agent_output["result"]["result"]

    prediction = result["prediction"]

    probability = prediction["termination_probability"]
    threshold = prediction["classification_threshold"]
    predicted_class = prediction["predicted_class"]


    # --------------------------------------------------------
    # 3. Extract prediction drivers
    # --------------------------------------------------------

    drivers = result["prediction_drivers"]

    increasing = [
        d for d in drivers
        if d["shap_value"] > 0
    ]

    decreasing = [
        d for d in drivers
        if d["shap_value"] < 0
    ]

    increasing = sorted(
        increasing,
        key=lambda x: abs(x["shap_value"]),
        reverse=True
    )[:top_n]

    decreasing = sorted(
        decreasing,
        key=lambda x: abs(x["shap_value"]),
        reverse=True
    )[:top_n]


    # --------------------------------------------------------
    # 4. Build classification statement
    # --------------------------------------------------------

    if predicted_class == 1:

        classification_text = (
            f"This exceeds the selected "
            f"{threshold:.0%} classification threshold."
        )

    else:

        classification_text = (
            f"This is below the selected "
            f"{threshold:.0%} classification threshold."
        )


    # --------------------------------------------------------
    # 5. Build factor descriptions
    # --------------------------------------------------------

    increasing_text = ", ".join(
        [
            f'{d["factor"]} (SHAP {d["shap_value"]:+.3f})'
            for d in increasing
        ]
    )

    decreasing_text = ", ".join(
        [
            f'{d["factor"]} (SHAP {d["shap_value"]:+.3f})'
            for d in decreasing
        ]
    )


    # --------------------------------------------------------
    # 6. Construct final response
    # --------------------------------------------------------

    response = (
        f"Predicted termination probability: {probability:.1%}. "
        f"{classification_text}\n\n"
    )

    if increasing_text:

        response += (
            "Major factors increasing the model prediction: "
            f"{increasing_text}.\n"
        )

    if decreasing_text:

        response += (
            "Major factors decreasing the model prediction: "
            f"{decreasing_text}.\n"
        )

    response += (
        "\nThese factors describe associations learned by the "
        "prediction model from historical clinical trial data. "
        "SHAP values explain contributions to this specific "
        "prediction and should not be interpreted as causal effects "
        "or clinical recommendations."
    )

    return response



