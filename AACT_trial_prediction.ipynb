# ============================================================
# Step 19A. Audit SHAP effects for all model features
# Purpose:
# Create a complete interpretation table for every transformed
# feature used by the primary XGBoost model.
#
# For every feature, calculate:
# 1. Mean absolute SHAP value:
#    overall importance of the feature.
#
# 2. Mean SHAP value:
#    average direction of contribution across all sampled trials.
#
# 3. For binary / one-hot features:
#    mean and median SHAP contribution when the feature is present.
#
# This table will later support the AI agent so that it can
# explain predictions using any predictor in the model rather
# than only a manually selected subset.
# ============================================================

import pandas as pd
import numpy as np

# ------------------------------------------------------------
# Create clean feature names
# ------------------------------------------------------------

clean_feature_names = [
    name
    .replace("cat__", "")
    .replace("num__", "")
    .replace("binary__", "")
    for name in shap_feature_names
]

# ------------------------------------------------------------
# Create result container
# ------------------------------------------------------------

all_feature_results = []

# ------------------------------------------------------------
# Loop through every transformed model feature
# ------------------------------------------------------------

for idx, feature in enumerate(clean_feature_names):

    # Feature values actually used by XGBoost
    feature_values = np.asarray(
        X_test_sample_transformed[:, idx]
    ).ravel()

    # SHAP values for this feature
    feature_shap = shap_values.values[:, idx]

    # Global SHAP importance
    mean_abs_shap = np.mean(
        np.abs(feature_shap)
    )

    # Average SHAP direction across all observations
    mean_shap_all = np.mean(
        feature_shap
    )

    # --------------------------------------------------------
    # Determine feature type
    # --------------------------------------------------------

    original_name = shap_feature_names[idx]

    if original_name.startswith("num__"):
        feature_type = "Continuous"

        n_present = np.nan
        mean_shap_present = np.nan
        median_shap_present = np.nan

    else:
        feature_type = "Binary / One-hot"

        # Feature == 1 means characteristic is present
        present_mask = feature_values == 1

        n_present = np.sum(
            present_mask
        )

        if n_present > 0:

            mean_shap_present = np.mean(
                feature_shap[present_mask]
            )

            median_shap_present = np.median(
                feature_shap[present_mask]
            )

        else:

            mean_shap_present = np.nan
            median_shap_present = np.nan

    # --------------------------------------------------------
    # Save results
    # --------------------------------------------------------

    all_feature_results.append({
        "Feature": feature,
        "Feature_type": feature_type,
        "Mean_abs_SHAP": mean_abs_shap,
        "Mean_SHAP_all": mean_shap_all,
        "N_present": n_present,
        "Mean_SHAP_when_present": mean_shap_present,
        "Median_SHAP_when_present": median_shap_present
    })


# ------------------------------------------------------------
# Convert to dataframe
# ------------------------------------------------------------

all_shap_audit = pd.DataFrame(
    all_feature_results
)

# Rank features from most to least important
all_shap_audit = (
    all_shap_audit
    .sort_values(
        "Mean_abs_SHAP",
        ascending=False
    )
    .reset_index(drop=True)
)

# Add importance rank
all_shap_audit.insert(
    0,
    "Importance_rank",
    range(1, len(all_shap_audit) + 1)
)

# ------------------------------------------------------------
# Display complete table
# ------------------------------------------------------------

print("Complete SHAP Audit of Model Features")
print("=" * 100)

print(
    all_shap_audit.to_string(
        index=False,
        float_format=lambda x: f"{x:.3f}"
    )
)



# ============================================================
# Step 19B. Aggregate SHAP importance by predictor group
# Purpose:
# Combine transformed features back into their original
# conceptual predictor groups.
#
# Examples:
# phase_PHASE1, phase_PHASE2, phase_PHASE3 -> Phase
# DRUG, DEVICE, BEHAVIORAL, etc.          -> Intervention
# agency_class_INDUSTRY, OTHER_GOV, etc.  -> Sponsor
# DISEASE_*                               -> Disease
#
# This provides a predictor-level interpretation that is more
# useful for reporting and for designing the AI agent.
# ============================================================

import pandas as pd
import numpy as np


# ------------------------------------------------------------
# Assign each transformed feature to a predictor group
# ------------------------------------------------------------

def assign_predictor_group(feature):

    # Continuous predictors
    if feature == "log_enrollment":
        return "Enrollment"

    if feature == "start_year":
        return "Start Year"

    # Phase indicators
    if feature.startswith("phase_"):
        return "Phase"

    # Sponsor indicators
    if feature.startswith("agency_class_"):
        return "Sponsor"

    # Disease indicators
    if feature.startswith("DISEASE_"):
        return "Disease"

    # Known intervention indicators
    intervention_features = [
        "DRUG",
        "DEVICE",
        "BIOLOGICAL",
        "BEHAVIORAL",
        "PROCEDURE",
        "RADIATION",
        "DIAGNOSTIC_TEST",
        "DIETARY_SUPPLEMENT",
        "GENETIC",
        "COMBINATION_PRODUCT",
        "OTHER"
    ]

    if feature in intervention_features:
        return "Intervention"

    # Anything not captured above
    return "Other"


# ------------------------------------------------------------
# Add predictor group to complete SHAP audit table
# ------------------------------------------------------------

all_shap_audit["Predictor_group"] = (
    all_shap_audit["Feature"]
    .apply(assign_predictor_group)
)


# ------------------------------------------------------------
# Sum mean absolute SHAP importance within each group
# ------------------------------------------------------------

group_shap_importance = (
    all_shap_audit
    .groupby("Predictor_group", as_index=False)
    .agg(
        N_transformed_features=("Feature", "count"),
        Total_mean_abs_SHAP=("Mean_abs_SHAP", "sum")
    )
